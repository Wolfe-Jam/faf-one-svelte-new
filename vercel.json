{
  "outputDirectory": "build",
  "buildCommand": "npm run build",
  "redirects": [
    { "source": "/docs/commands", "destination": "https://docs.faf.one", "permanent": true },
    { "source": "/docs", "destination": "https://docs.faf.one", "permanent": true },
    { "source": "/founders", "destination": "/sponsors", "permanent": true },
    { "source": "/drift", "destination": "/ecosystem", "permanent": true },
    { "source": "/rust", "destination": "/pro", "permanent": true },
    { "source": "/3ws", "destination": "/ideas", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "mcpaas.live" }],
      "destination": "/mcpaas"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}