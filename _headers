# HSTS — browsers upgrade http://faf.one to https:// before the request, so a
# stray/typed http:// link can't create an insecure download hop. Apex only
# (no includeSubDomains: a not-fully-HTTPS subdomain must not be forced).
/*
  Strict-Transport-Security: max-age=31536000

# Correct media types for FAF artifacts served from the well-known AI Catalog.
/.well-known/ai-catalog.json
  Content-Type: application/ai-catalog+json; charset=utf-8

# RFC 8615 well-known URI "faf" - canonical discovery anchor (draft-wolfe-faf-format).
/.well-known/faf
  Content-Type: application/vnd.faf+yaml; charset=utf-8

/.well-known/project.faf
  Content-Type: application/vnd.faf+yaml; charset=utf-8

/.well-known/project.fafm
  Content-Type: application/vnd.fafm+yaml; charset=utf-8

/.well-known/grok.fafm
  Content-Type: application/vnd.fafm+yaml; charset=utf-8

# Agent layer — the FAF Agent Card (.fafa) completes the context/memory/agent trinity.

# The canonical FAF Agent anchor (.fafa) — mirrors /.well-known/faf. Live agent: uvx faf-agent-mcp.
/.well-known/fafa
  Content-Type: application/vnd.fafa+yaml; charset=utf-8

/.well-known/claude.fafa
  Content-Type: application/vnd.fafa+yaml; charset=utf-8
